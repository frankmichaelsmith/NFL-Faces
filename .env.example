# Copy to .env (gitignored). Nothing here is required for local dev.
VITE_IMAGE_BASE_URL=/faces/        # where normalized headshots are served from
VITE_SITE_URL=                     # public URL printed on share cards (defaults to the page origin)
VITE_BUILD_HASH=                   # injected by CI/Vercel from the git SHA
VITE_POSTHOG_KEY=                  # unset = analytics no-op backend
VITE_POSTHOG_HOST=https://us.i.posthog.com
